{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; style-src 'self' 'unsafe-inline'; script-src 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/app.html" },
    { "source": "/plans", "destination": "/app.html" },
    { "source": "/domains", "destination": "/app.html" },
    { "source": "/dns-zones", "destination": "/app.html" },
    { "source": "/sites", "destination": "/app.html" },
    { "source": "/sites/:path*", "destination": "/app.html" },
    { "source": "/marketplace", "destination": "/app.html" },
    { "source": "/billing", "destination": "/app.html" },
    { "source": "/support", "destination": "/app.html" },
    { "source": "/ssl", "destination": "/app.html" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/legal/:path*", "destination": "/app.html" }
  ]
}
