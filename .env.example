# ── Frontend (Vite — exposed to the browser, RLS enforced) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ── Edge Function secrets (set with `supabase secrets set`, never VITE_) ────
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform in deployed functions.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
APP_URL=https://maxmark.com.ng
APP_ENV=production
WHM_HOST=whm.maxmark.example
WHM_PORT=2087
WHM_API_USERNAME=root
WHM_MASTER_TOKEN=replace-with-whm-api-token
MOCK_WHM_REQUESTS=false
# HTTPS service that accepts { action: install|remove, domain, documentRoot,
# databaseName, databaseUser, databasePassword } and returns { success: true }.
WORDPRESS_INSTALLER_URL=https://installer.maxmark.example/v1/wordpress
WORDPRESS_INSTALLER_TOKEN=replace-with-a-long-random-service-token
